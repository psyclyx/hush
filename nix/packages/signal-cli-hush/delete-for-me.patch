diff --git a/lib/src/main/java/org/asamk/signal/manager/internal/ManagerImpl.java b/lib/src/main/java/org/asamk/signal/manager/internal/ManagerImpl.java
index 2026c52..82dd52b 100644
--- a/lib/src/main/java/org/asamk/signal/manager/internal/ManagerImpl.java
+++ b/lib/src/main/java/org/asamk/signal/manager/internal/ManagerImpl.java
@@ -1062,6 +1062,52 @@ public class ManagerImpl implements Manager {
         return mentions;
     }
 
+    @Override
+    public void sendDeleteForMe(
+            final RecipientIdentifier conversation,
+            final RecipientIdentifier.Single author,
+            final List<Long> sentTimestamps
+    ) throws IOException, UnregisteredRecipientException {
+        if (!account.isMultiDevice()) {
+            logger.debug("Not sending delete-for-me sync message because there are no linked devices.");
+            return;
+        }
+        final var conversationId = new org.whispersystems.signalservice.internal.push.ConversationIdentifier.Builder();
+        switch (conversation) {
+            case RecipientIdentifier.Group(var groupId) ->
+                    conversationId.threadGroupId(okio.ByteString.of(groupId.serialize()));
+            case RecipientIdentifier.Single single -> conversationId.threadServiceId(resolveServiceIdString(single));
+            case RecipientIdentifier.NoteToSelf ignored ->
+                    conversationId.threadServiceId(account.getAci().toString());
+        }
+        final var authorServiceId = resolveServiceIdString(author);
+        final var messages = sentTimestamps.stream()
+                .map(ts -> new org.whispersystems.signalservice.internal.push.AddressableMessage.Builder().authorServiceId(
+                        authorServiceId).sentTimestamp(ts).build())
+                .toList();
+        final var messageDeletes = new org.whispersystems.signalservice.internal.push.SyncMessage.DeleteForMe.MessageDeletes.Builder().conversation(
+                conversationId.build()).messages(messages).build();
+        final var deleteForMe = new org.whispersystems.signalservice.internal.push.SyncMessage.DeleteForMe.Builder().messageDeletes(
+                List.of(messageDeletes)).build();
+        final var syncMessage = new org.whispersystems.signalservice.internal.push.SyncMessage.Builder().deleteForMe(
+                deleteForMe).build();
+        final var content = new org.whispersystems.signalservice.internal.push.Content.Builder().syncMessage(
+                syncMessage).build();
+        try {
+            dependencies.getMessageSender().sendSyncMessage(content, false, Optional.empty());
+        } catch (org.whispersystems.signalservice.api.crypto.UntrustedIdentityException | org.signal.libsignal.protocol.NoSessionException e) {
+            throw new IOException("Failed to send delete-for-me sync message: " + e.getMessage(), e);
+        }
+    }
+
+    private String resolveServiceIdString(final RecipientIdentifier.Single single) throws IOException, UnregisteredRecipientException {
+        final var recipientId = context.getRecipientHelper().resolveRecipient(single);
+        final var address = account.getRecipientAddressResolver().resolveRecipientAddress(recipientId);
+        return address.serviceId()
+                .orElseThrow(() -> new IOException("No service id known for " + single.getIdentifier()))
+                .toString();
+    }

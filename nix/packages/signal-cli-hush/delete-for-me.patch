@@ -0,0 +1,85 @@
+package org.asamk.signal.commands;
+
+import net.sourceforge.argparse4j.impl.Arguments;
+import net.sourceforge.argparse4j.inf.Namespace;
+import net.sourceforge.argparse4j.inf.Subparser;
+
+import org.asamk.signal.commands.exceptions.CommandException;
+import org.asamk.signal.commands.exceptions.UnexpectedErrorException;
+import org.asamk.signal.commands.exceptions.UserErrorException;
+import org.asamk.signal.manager.Manager;
+import org.asamk.signal.manager.api.RecipientIdentifier;
+import org.asamk.signal.manager.api.UnregisteredRecipientException;
+import org.asamk.signal.output.OutputWriter;
+import org.asamk.signal.util.CommandUtil;
+
+import java.io.IOException;
+
+public class DeleteForMeCommand implements JsonRpcLocalCommand {
+
+    @Override
+    public String getName() {
+        return "deleteForMe";
+    }
+
+    @Override
+    public void attachToSubparser(final Subparser subparser) {
+        subparser.help("Delete messages from this account's other devices only (\"delete for me\").");
+        subparser.addArgument("-a", "--target-author")
+                .required(true)
+                .help("Specify the number or uuid of the messages' author.");
+        subparser.addArgument("-t", "--target-timestamp")
+                .required(true)
+                .type(long.class)
+                .nargs("+")
+                .help("Specify the sent timestamps of the messages to delete.");
+        final var conversation = subparser.addMutuallyExclusiveGroup().required(true);
+        conversation.addArgument("-g", "--group-id", "--group").help("Specify the conversation's group ID.");
+        conversation.addArgument("-r", "--recipient").help("Specify the 1:1 conversation's number or uuid.");
+        conversation.addArgument("--note-to-self").action(Arguments.storeTrue());
+    }
+
+    @Override
+    public void handleCommand(
+            final Namespace ns,
+            final Manager m,
+            final OutputWriter outputWriter
+    ) throws CommandException {
+        final var localNumber = m.getSelfNumber();
+        final RecipientIdentifier conversation;
+        final var groupId = ns.getString("group-id");
+        final var recipient = ns.getString("recipient");
+        if (groupId != null) {
+            conversation = new RecipientIdentifier.Group(CommandUtil.getGroupId(groupId));
+        } else if (recipient != null) {
+            conversation = CommandUtil.getSingleRecipientIdentifier(recipient, localNumber);
+        } else if (Boolean.TRUE.equals(ns.getBoolean("note-to-self"))) {
+            conversation = new RecipientIdentifier.NoteToSelf();
+        } else {
+            // JSON-RPC bypasses argparse, so the required group isn't enforced there.
+            throw new UserErrorException("One of group-id, recipient or note-to-self is required");
+        }
+        final var authorString = ns.getString("target-author");
+        if (authorString == null) {
+            throw new UserErrorException("Missing target-author");
+        }
+        final var author = CommandUtil.getSingleRecipientIdentifier(authorString, localNumber);
+        final var rawTimestamps = ns.<Object>getList("target-timestamp");
+        if (rawTimestamps == null || rawTimestamps.isEmpty()) {
+            throw new UserErrorException("Missing target-timestamp");
+        }
+        // JSON-RPC numbers may arrive as Integer or Long.
+        final var timestamps = rawTimestamps.stream().map(t -> ((Number) t).longValue()).toList();
+
+        try {
+            m.sendDeleteForMe(conversation, author, timestamps);
+        } catch (UnregisteredRecipientException e) {
+            throw new UserErrorException("The user " + e.getSender().getIdentifier() + " is not registered.");
+        } catch (UnsupportedOperationException e) {
+            throw new UserErrorException(e.getMessage());
+        } catch (IOException e) {
+            throw new UnexpectedErrorException("Failed to send delete-for-me: " + e.getMessage() + " (" + e.getClass()
+                    .getSimpleName() + ")", e);
+        }
+    }
+}
